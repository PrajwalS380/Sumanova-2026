# Copy to .env.local and fill in from Supabase Dashboard -> Project Settings -> API.
# Only the publishable (anon) key belongs here. NEVER put the service-role key in frontend env.
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
# Optional branding override (defaults to SUMANOVA)
VITE_APP_NAME=SUMANOVA
# Optional TURN relay for calls on strict networks (see docs/CALLS.md). Leave empty to use STUN only.
VITE_TURN_URL=
VITE_TURN_USERNAME=
VITE_TURN_CREDENTIAL=
